# 本地开发环境变量模板（复制为 .env 后按需修改）
# 生产部署请使用 .env.prod.example，两者变量集合一致但默认值不同。

# ---------------------------------------------------------------------------
# 运行环境
# development / staging / production
# production 会启用安全基线自检：AUTH_MODE=token、AUTH_SECRET>=32 位、CORS 非 *
# ---------------------------------------------------------------------------
ENVIRONMENT=development
APP_VERSION=0.1.0

# 日志：text（本地可读）/ json（生产采集）
LOG_LEVEL=INFO
LOG_FORMAT=text

# 数据库
DATABASE_URL=postgresql+asyncpg://auditflow:auditflow@localhost:5433/auditflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=auditflow
POSTGRES_PASSWORD=auditflow
POSTGRES_DB=auditflow

# 连接池（SQLite 下不生效）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECS=1800
DB_POOL_TIMEOUT_SECS=30
DB_CONNECT_TIMEOUT_SECS=10

# Redis（限流与案件锁后端；不可用时自动降级为进程内实现）
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECS=1.0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=auditflow
MINIO_SECRET_KEY=auditflow123
MINIO_BUCKET=auditflow-docs
MINIO_SECURE=false

# 文档存储后端：minio（默认，走容器）或 local（落 data/_storage，便于离线开发）
STORAGE_BACKEND=minio

# Mock ERP
MOCK_ERP_URL=http://localhost:8010
# true：进程内 ASGI（测试/离线演示，无需启动 Mock ERP 容器）
MOCK_ERP_INPROCESS=false

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=8000
# 逗号分隔的显式白名单；生产不得为 *
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=20
MAX_REQUEST_MB=25
MAX_DOCUMENTS_PER_CASE=20
# 生产建议 false：关闭 /docs、/redoc、/openapi.json
DOCS_ENABLED=true
SECURITY_HEADERS_ENABLED=true
# 仅当 API 位于可信反向代理之后时开启，避免直接暴露时伪造 X-Real-IP
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# 鉴权（文档 §15）
# dev  ：信任 X-Role / X-User-Id 请求头，仅用于本地演示，不可对外暴露
# token：HMAC-SHA256 Bearer Token，生产必须使用；签发命令见 README
# ---------------------------------------------------------------------------
AUTH_MODE=dev
AUTH_SECRET=auditflow-dev-secret-change-me
AUTH_TOKEN_TTL_SECS=3600
# 非空时 /metrics 需携带 Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=

# ---------------------------------------------------------------------------
# 限流与并发（开发默认关闭；production 自动启用）
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=30
RATE_LIMIT_BACKEND=memory   # memory / redis
CASE_LOCK_BACKEND=memory    # memory / redis（多副本部署必须 redis）
READINESS_TIMEOUT_SECS=3.0

# ---------------------------------------------------------------------------
# 模型网关（文档 §17）
# stub               ：本地确定性实现，全流程可跑通，无需 GPU
# openai_compatible  ：接入 AutoDL / vLLM / SGLang / Ollama 等 OpenAI 兼容服务
# ---------------------------------------------------------------------------
MODEL_PROVIDER=stub
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=qwen2.5-7b-instruct
VISION_MODEL_NAME=
EMBEDDING_MODEL=bge-m3
RERANKER_MODEL=bge-reranker-v2-m3
MODEL_TIMEOUT_SECS=30
MODEL_MAX_RETRIES=2

# Agent 预算（文档 §10.4）
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_REPLANS=1
AGENT_RETRIES_PER_TOOL=2
AGENT_MAX_STEPS=12

# Trace
TRACE_STORE_URL=postgresql+asyncpg://auditflow:auditflow@localhost:5433/auditflow

# 前端（Vite）
VITE_API_BASE=http://localhost:8000
