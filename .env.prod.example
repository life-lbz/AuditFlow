# AuditFlow 生产环境变量模板
# 用法：cp .env.prod.example .env.prod，填写下面标记 [必填] 的值后执行
#   docker compose --env-file .env.prod -f infra/docker-compose.prod.yml up -d --build
# 切勿把 .env.prod 提交到版本库。

# ---- 运行环境 ----
APP_VERSION=0.1.0
ENVIRONMENT=production
LOG_FORMAT=json
LOG_LEVEL=INFO
DOCS_ENABLED=false

# ---- [必填] 数据库 ----
POSTGRES_USER=auditflow
POSTGRES_DB=auditflow
# 生成：openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- [必填] 对象存储 ----
MINIO_ACCESS_KEY=auditflow
MINIO_BUCKET=auditflow-docs
# 生成：openssl rand -hex 24
MINIO_SECRET_KEY=

# ---- [必填] 鉴权 ----
# 生成：openssl rand -hex 32；长度不足 32 或使用默认值时 API 拒绝启动
AUTH_SECRET=
AUTH_TOKEN_TTL_SECS=3600

# ---- [必填] 前端来源（用于 CORS；不得为 *） ----
# 单机部署示例：http://localhost:8080
# 域名部署示例：https://auditflow.example.com
CORS_ORIGINS=

# ---- 对外端口 ----
WEB_PORT=8080

# ---- 模型网关 ----
# stub 仅用于演示；接入真实模型时改为 openai_compatible 并填写下列参数
MODEL_PROVIDER=stub
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=qwen2.5-7b-instruct

# ---- 限流与指标 ----
# 可留空：指标端点仅在内网可访问；设置后 Prometheus 抓取需带 Bearer
METRICS_TOKEN=

# ---- 上传与连接池 ----
MAX_UPLOAD_MB=20
MAX_REQUEST_MB=25
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
