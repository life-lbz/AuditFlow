# 前端生产镜像：Vite 构建 + nginx 反代
# IMAGE_BASE 允许海外部署时覆盖为官方源，例如：
#   docker build --build-arg IMAGE_BASE=library -t auditflow-web .
ARG IMAGE_BASE=docker.m.daocloud.io/library

FROM ${IMAGE_BASE}/node:22-alpine AS build

WORKDIR /app

# 生产构建把 API 基址指到同源 /api，由 nginx 反代到 api 容器
ARG VITE_API_BASE=/api
ENV VITE_API_BASE=${VITE_API_BASE}

COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --registry=https://registry.npmmirror.com

COPY apps/web/ ./
RUN npm run build


FROM ${IMAGE_BASE}/nginx:1.27-alpine

COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
    CMD wget -qO- http://localhost/ >/dev/null || exit 1
